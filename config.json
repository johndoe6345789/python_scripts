{
  "name": "Raspbian SD Card Configuration",
  "active": true,
  "nodes": [
    {
      "id": "hostname_write",
      "name": "Write Hostname",
      "type": "file.write",
      "typeVersion": 1,
      "position": [100, 100],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/hostname",
        "content": "{hostname}\n",
        "condition": "{hostname}"
      }
    },
    {
      "id": "hosts_read",
      "name": "Read /etc/hosts",
      "type": "file.read",
      "typeVersion": 1,
      "position": [100, 200],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/hosts",
        "condition": "{hostname}"
      }
    },
    {
      "id": "hosts_replace",
      "name": "Replace hostname in hosts",
      "type": "text.replace",
      "typeVersion": 1,
      "position": [300, 200],
      "disabled": false,
      "parameters": {
        "text": "{{hosts_read.data.content}}",
        "find": "raspberrypi",
        "replace": "{hostname}"
      }
    },
    {
      "id": "hosts_write",
      "name": "Write /etc/hosts",
      "type": "file.write",
      "typeVersion": 1,
      "position": [500, 200],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/hosts",
        "content": "{{hosts_replace.data.result}}",
        "condition": "{hostname}"
      }
    },
    {
      "id": "ssh_enable",
      "name": "Enable SSH",
      "type": "file.touch",
      "typeVersion": 1,
      "position": [100, 300],
      "disabled": false,
      "parameters": {
        "path": "{mount.boot}/ssh",
        "condition": "{enable_ssh}"
      }
    },
    {
      "id": "gpu_config_read",
      "name": "Read config.txt",
      "type": "file.read",
      "typeVersion": 1,
      "position": [100, 400],
      "disabled": false,
      "parameters": {
        "path": "{mount.boot}/config.txt",
        "condition": "{gpu_mem}"
      }
    },
    {
      "id": "gpu_filter",
      "name": "Filter GPU lines",
      "type": "text.filter_lines",
      "typeVersion": 1,
      "position": [300, 400],
      "disabled": false,
      "parameters": {
        "text": "{{gpu_config_read.data.content}}",
        "exclude": ["^gpu_mem"],
        "condition": "{gpu_mem}"
      }
    },
    {
      "id": "gpu_append",
      "name": "Append GPU setting",
      "type": "text.append",
      "typeVersion": 1,
      "position": [500, 400],
      "disabled": false,
      "parameters": {
        "text": "{{gpu_filter.data.result}}",
        "line": "gpu_mem={gpu_mem}",
        "condition": "{gpu_mem}"
      }
    },
    {
      "id": "gpu_config_write",
      "name": "Write config.txt",
      "type": "file.write",
      "typeVersion": 1,
      "position": [700, 400],
      "disabled": false,
      "parameters": {
        "path": "{mount.boot}/config.txt",
        "content": "{{gpu_append.data.result}}",
        "condition": "{gpu_mem}"
      }
    },
    {
      "id": "oc_config_read",
      "name": "Read config.txt (overclock)",
      "type": "file.read",
      "typeVersion": 1,
      "position": [100, 500],
      "disabled": false,
      "parameters": {
        "path": "{mount.boot}/config.txt",
        "condition": "{overclock} != 'none'"
      }
    },
    {
      "id": "oc_filter",
      "name": "Filter overclock lines",
      "type": "text.filter_lines",
      "typeVersion": 1,
      "position": [300, 500],
      "disabled": false,
      "parameters": {
        "text": "{{oc_config_read.data.content}}",
        "exclude": ["^arm_freq", "^gpu_freq", "^over_voltage"],
        "condition": "{overclock} != 'none'"
      }
    },
    {
      "id": "oc_preset_apply",
      "name": "Apply overclock preset",
      "type": "preset.apply",
      "typeVersion": 1,
      "position": [500, 500],
      "disabled": false,
      "parameters": {
        "text": "{{oc_filter.data.result}}",
        "preset": "{overclock}",
        "condition": "{overclock} != 'none'"
      }
    },
    {
      "id": "oc_config_write",
      "name": "Write config.txt (overclock)",
      "type": "file.write",
      "typeVersion": 1,
      "position": [700, 500],
      "disabled": false,
      "parameters": {
        "path": "{mount.boot}/config.txt",
        "content": "{{oc_preset_apply.data.result}}",
        "condition": "{overclock} != 'none'"
      }
    },
    {
      "id": "wifi_template",
      "name": "Generate WiFi config",
      "type": "text.template",
      "typeVersion": 1,
      "position": [100, 600],
      "disabled": false,
      "parameters": {
        "template": "wpa_supplicant",
        "vars": {
          "ssid": "{wifi_ssid}",
          "password": "{wifi_password}",
          "country": "{wifi_country}"
        },
        "condition": "{wifi_ssid} && {wifi_password}"
      }
    },
    {
      "id": "wifi_write",
      "name": "Write WiFi config",
      "type": "file.write",
      "typeVersion": 1,
      "position": [300, 600],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/wpa_supplicant/wpa_supplicant.conf",
        "content": "{{wifi_template.data.result}}",
        "condition": "{wifi_ssid} && {wifi_password}"
      }
    },
    {
      "id": "shadow_read",
      "name": "Read shadow file",
      "type": "file.read",
      "typeVersion": 1,
      "position": [100, 700],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/shadow",
        "condition": "{user_username} && {user_password}"
      }
    },
    {
      "id": "password_hash",
      "name": "Hash password",
      "type": "crypto.sha512",
      "typeVersion": 1,
      "position": [300, 700],
      "disabled": false,
      "parameters": {
        "password": "{user_password}",
        "condition": "{user_username} && {user_password}"
      }
    },
    {
      "id": "shadow_update",
      "name": "Update shadow entry",
      "type": "text.sed",
      "typeVersion": 1,
      "position": [500, 700],
      "disabled": false,
      "parameters": {
        "text": "{{shadow_read.data.content}}",
        "pattern": "^{user_username}:([^:]*)",
        "replacement": "{user_username}:{{password_hash.data.hash}}",
        "condition": "{user_username} && {user_password}"
      }
    },
    {
      "id": "shadow_write",
      "name": "Write shadow file",
      "type": "file.write",
      "typeVersion": 1,
      "position": [700, 700],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/shadow",
        "content": "{{shadow_update.data.result}}",
        "chmod": "0o000",
        "condition": "{user_username} && {user_password}"
      }
    },
    {
      "id": "configuration_complete",
      "name": "Configuration Complete",
      "type": "noop",
      "typeVersion": 1,
      "position": [800, 350],
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "error_handler",
      "name": "Handle Errors",
      "type": "noop",
      "typeVersion": 1,
      "position": [800, 550],
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "verify_hostname",
      "name": "Verify Hostname Applied",
      "type": "file.read",
      "typeVersion": 1,
      "position": [1000, 100],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/hostname",
        "condition": "{hostname}"
      }
    },
    {
      "id": "verify_wifi",
      "name": "Verify WiFi Config",
      "type": "file.read",
      "typeVersion": 1,
      "position": [1000, 600],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/wpa_supplicant/wpa_supplicant.conf",
        "condition": "{wifi_ssid} && {wifi_password}"
      }
    },
    {
      "id": "verify_shadow",
      "name": "Verify Shadow Updated",
      "type": "file.read",
      "typeVersion": 1,
      "position": [1000, 700],
      "disabled": false,
      "parameters": {
        "path": "{mount.rootfs}/etc/shadow",
        "condition": "{user_username} && {user_password}"
      }
    },
    {
      "id": "success_notification",
      "name": "All Verified ✓",
      "type": "noop",
      "typeVersion": 1,
      "position": [1200, 400],
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "failure_notification",
      "name": "Verification Failed ✗",
      "type": "noop",
      "typeVersion": 1,
      "position": [1200, 600],
      "disabled": false,
      "parameters": {}
    }
  ],
