  "settings": {},
  "meta": {
    "mounts": {
      "boot": "boot",
      "rootfs": "rootfs"
    },
    "fields": [
      {
        "id": "hostname",
        "label": "Hostname",
        "type": "string",
        "default": "raspberrypi",
        "validate": [{"type": "pattern", "pattern": "^[a-zA-Z0-9-]+$"}]
      },
      {
        "id": "enable_ssh",
        "label": "Enable SSH",
        "type": "bool",
        "default": true
      },
      {
        "id": "gpu_mem",
        "label": "GPU Memory (MB)",
        "type": "int",
        "default": null
      },
      {
        "id": "overclock",
        "label": "Overclock Preset",
        "type": "choice",
        "default": "none"
      },
      {
        "id": "wifi_ssid",
        "label": "WiFi SSID",
        "type": "string",
        "default": ""
      },
      {
        "id": "wifi_password",
        "label": "WiFi Password",
        "type": "password",
        "default": ""
      },
      {
        "id": "wifi_country",
        "label": "WiFi Country Code",
        "type": "string",
        "default": "US",
        "validate": [{"type": "pattern", "pattern": "^[A-Z]{2}$"}]
      },
      {
        "id": "user_username",
        "label": "Pi Username",
        "type": "string",
        "default": "pi"
      },
      {
        "id": "user_password",
        "label": "Pi Password",
        "type": "password",
        "default": ""
      }
    ],
    "presets": {
      "modest": {"arm_freq": 1900, "gpu_freq": 600, "over_voltage": 2},
      "medium": {"arm_freq": 2000, "gpu_freq": 650, "over_voltage": 4},
      "high": {"arm_freq": 2147, "gpu_freq": 750, "over_voltage": 6}
    },
    "templates": {
      "wpa_supplicant": "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev\nupdate_config=1\ncountry={country}\n\nnetwork={{\n    ssid=\"{ssid}\"\n    psk=\"{password}\"\n    key_mgmt=WPA-PSK\n}}\n"
    },
    "strings": {
      "nav_help": "↑/↓: Navigate | Enter: Edit | Space: Toggle | Ctrl+S: Save | Ctrl+Q: Quit",
      "apply_success": "Configuration applied successfully!",
      "apply_error": "Configuration error: {error}",
      "invalid_mount": "Invalid mount path. Need 'boot' and 'rootfs' directories"
    }
  }
}
